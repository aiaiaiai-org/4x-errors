{
  "name": "@aiaiaiai/4x-errors-browser",
  "version": "0.1.0",
  "description": "Fail-safe browser reporter for the 4x-errors protocol.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiaiaiai-org/4x-errors.git",
    "directory": "sdk/browser"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js && tsc --project test/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3"
  }
}
