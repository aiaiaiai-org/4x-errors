# Run bin/self-host setup to generate the database password and this configuration.
POSTGRES_PASSWORD=replace-with-generated-password
BROWSER_INGEST_ORIGINS='"my/app":"https://app.example.com",'
COLLECTOR_PUBLIC_ORIGIN=https://errors.example.com
COMPOSE_PROFILES=public
COLLECTOR_LOCAL_PORT=1927
# Optional: run a prebuilt image instead of building this checkout.
# COLLECTOR_IMAGE=ghcr.io/your-account/your-fork:sha-verified-commit
# Optional server-only token digests; never give tokens to browser clients.
# INGEST_TOKEN_DIGESTS='{"my/server":"sha256-token-digest"}'
